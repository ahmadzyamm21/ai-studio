generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  brand         String
  category      String
  theme         String?
  targetAge     String?
  shellMaterial String?
  visor         String?
  buckle        String?
  status        String   @default("ACTIVE")
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        ProductImage[]
  dna           ProductDNA?
}

model ProductImage {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  slot       String
  filename   String
  path       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, slot])
}

model ProductDNA {
  id            String   @id @default(cuid())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String   @unique

  // Identity
  sku           String?
  brand         String?
  category      String?
  ageRange      String?
  gender        String?

  // Construction
  material      String?
  finishing     String?
  visor         String?
  buckle        String?
  weight        String?
  sni           Boolean  @default(false)

  // Visual Identity
  theme         String?
  primaryColor  String?
  secondaryColor String?
  accentColor   String?
  pattern       String?
  logoPosition  String?

  // AI Protection
  brandLock     Boolean  @default(true)
  shapeLock     Boolean  @default(true)
  materialLock  Boolean  @default(true)
  graphicLock   Boolean  @default(true)
  logoLock      Boolean  @default(true)
  colorLock     Boolean  @default(true)

  // AI Notes
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
